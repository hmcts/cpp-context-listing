{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/progression/courts/public.progression.offences-removed-from-existing-allocated-hearing.json",
  "description": "Offences moved off an existing allocated hearing by progression, to be removed from that hearing in listing",
  "type": "object",
  "properties": {
    "hearingId": {
      "description": "Hearing the offences are to be removed from",
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
    },
    "offenceIds": {
      "description": "Offences to be removed from hearingId",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
      }
    }
  },
  "required": [
    "hearingId",
    "offenceIds"
  ]
}
