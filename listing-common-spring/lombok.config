# Lombok config for the Gradle (Spring Boot) modules. @Lazy on a final field is copied onto the
# @RequiredArgsConstructor parameter, so Spring injects a lazy proxy: used where the JEE code
# relied on CDI's lazy @ApplicationScoped instantiation (e.g. ReferenceDataCache, whose
# @PostConstruct calls referencedata and must not run at application start).
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
