{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/listing/query/listing.search.judiciary.json",
  "type": "object",
  "properties": {
    "courtHouseId": {
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
    },
    "courtRoomId": {
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
    },
    "courtSessionDate": {
      "type": "string",
      "format": "date"
    },
    "amCourtSession": {
      "$ref": "#/definitions/courtSession"
    },
    "pmCourtSession": {
      "$ref": "#/definitions/courtSession"
    }
  },
  "required": [
    "courtHouseId",
    "courtRoomId",
    "courtSessionDate"
  ],
  "additionalProperties": false,
  "definitions": {
    "courtSession": {
      "type": "object",
      "properties": {
        "judiciaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
          }
        }
      },
      "required": [
        "judiciaries"
      ],
      "additionalProperties": false
    }
  }
}
