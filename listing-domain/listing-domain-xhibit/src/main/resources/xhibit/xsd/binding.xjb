<?xml version="1.0" encoding="UTF-8"?>
<!-- Jakarta JAXB (3.0) bindings. The old jaxb2-commons namespace:prefix customisations were removed with the
     javax-only jaxb2-namespace-prefix plugin (see pom NOTE) — they only set output XML namespace prefixes for the
     DailyList; listing team to re-add a Jakarta-compatible namespace-prefix plugin if the XHIBIT XML output needs them. -->
<jaxb:bindings xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
               xmlns:xs="http://www.w3.org/2001/XMLSchema"
               xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
               jaxb:version="3.0">

  <jaxb:globalBindings>
    <xjc:javaType xmlType="xs:date" name="java.time.LocalDate"
                  adapter="uk.gov.moj.cpp.listing.domain.xhibit.LocalDateAdapter"/>
  </jaxb:globalBindings>

  <jaxb:bindings schemaLocation="1_CourtService.xsd"
                 node="//xs:complexType[@name='CustodialTermStructure']//xs:attribute[@name='Section44']">
    <jaxb:property name="Section440"/>
  </jaxb:bindings>

</jaxb:bindings>
