<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>listing-domain</artifactId>
        <groupId>uk.gov.moj.cpp.listing</groupId>
        <version>25.104.2-M2-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>listing-domain-xhibit</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Jakarta successor of the deprecated org.jvnet.jaxb2.maven2:maven-jaxb2-plugin; emits jakarta.xml.bind.
                 NOTE (listing team): the old -Xnamespace-prefix add-on (jaxb2-namespace-prefix, javax-only) was dropped —
                 it only affects XML namespace-prefix output of the generated XHIBIT classes, not compilation. Re-add a
                 Jakarta-compatible namespace-prefix plugin if the XHIBIT XML output requires the custom prefixes. -->
            <plugin>
                <groupId>org.jvnet.jaxb</groupId>
                <artifactId>jaxb-maven-plugin</artifactId>
                <version>4.0.8</version>
                <configuration>
                    <schemaDirectory>src/main/resources/xhibit/xsd</schemaDirectory>
                    <strict>false</strict>
                    <args>
                        <arg>-XautoNameResolution</arg>
                        <arg>-extension</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatePackage>uk.gov.moj.cpp.listing.domain.xhibit.generated</generatePackage>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
