{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/listing/courts/listing.restore-offence-ordering-bdf.json",
  "description": "LPT-2698 BDF: restore orderIndex/count (from progression) on offences of the hearing in the path. System user only; filled only where missing.",
  "type": "object",
  "properties": {
    "restoredOffences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
          },
          "defendantId": {
            "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
          },
          "offenceId": {
            "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
          },
          "orderIndex": {
            "type": "integer"
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "caseId",
          "defendantId",
          "offenceId",
          "orderIndex"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "restoredOffences"
  ],
  "additionalProperties": false
}
