<?xml version="1.0" encoding="UTF-8"?>
<!--
  JSON logging to stdout (§15.9, context/logging-standards.md): one JSON object per line via
  logstash-logback-encoder, for the cluster's log shipper. Levels come from application.yaml
  (logging.level.root = ${LOG_LEVEL_ROOT:WARN}, logging.level.uk.gov.moj.cpp.listing =
  ${LOG_LEVEL_LISTING:INFO}); Spring Boot applies them on top of this file.
  Courtscheduler has the encoder dependency but no logback config; this closes that gap (ADR 007).
-->
<configuration>
    <springProperty scope="context" name="applicationName" source="spring.application.name" defaultValue="listing-api"/>

    <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${applicationName}"}</customFields>
            <timeZone>UTC</timeZone>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="JSON_STDOUT"/>
    </root>
</configuration>
