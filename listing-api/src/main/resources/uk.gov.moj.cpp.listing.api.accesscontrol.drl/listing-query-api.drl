// Ported from listing-query/listing-query-api/src/main/resources/uk/gov/moj/cpp/listing/queryapi/accesscontrol/listing-query-api.drl
// (ADR 005). Group lists are unchanged. Changes from the legacy file:
//   - imports/global: cp-auth-rules-filter types (uk.gov.moj.cpp.authz.*) replace the framework's
//     uk.gov.moj.cpp.accesscontrol.*; RuleConstants is a copy in listing-api;
//   - Action.name: cp-auth-rules-filter resolves a GET's action from the Accept vendor token
//     (§11 pitfall 3), not from the RAML mapping name. Seven legacy actions share the token
//     listing.search.hearings (one per path, with different group lists), so those rules also
//     match the request path (Action attribute "path", relative to the /listing-service context
//     path). The legacy name is kept in a comment on each changed rule.
//   - Rules whose endpoints bypass access control on WildFly (hearingSlots, the CSV report,
//     sessionAvailabilityValidation, courtScheduleDraftStatus: hand-written JAX-RS resources that
//     never ran the interceptor chain) are kept for reference but are not evaluated: those paths
//     are in authz.http.exclude-path-prefixes (exact parity, §15.5).
//   - listing.public.list has no endpoint in the RAML (dead rule, kept unchanged).
// Rule names are unchanged, so they still read as the legacy action names.
package uk.gov.moj.cpp.listing.api.accesscontrol.drl;

import uk.gov.moj.cpp.authz.drools.Outcome;
import uk.gov.moj.cpp.authz.drools.Action;
import uk.gov.moj.cpp.listing.api.accesscontrol.RuleConstants;

global uk.gov.moj.cpp.authz.http.providers.UserAndGroupProvider userAndGroupProvider;

rule "Query - API - listing.search.hearings"
  when
    $outcome: Outcome();
    $action: Action(name == "listing.search.hearings", attributes["path"] == "/query/api/rest/listing/hearings");   // legacy action name: listing.search.hearings
    eval(userAndGroupProvider.isMemberOfAnyOfTheSuppliedGroups($action, RuleConstants.LISTING_OFFICERS, RuleConstants.COURT_CLERKS, RuleConstants.LEGAL_ADVISERS, RuleConstants.COURT_ADMINISTRATORS, RuleConstants.CROWN_COURT_ADMIN, RuleConstants.YOTS, RuleConstants.CPS, RuleConstants.NPS, RuleConstants.COURT_ASSOCIATE, RuleConstants.NON_CPS_PROSECUTOR_GROUP, RuleConstants.OPERATIONAL_DELIVERY_ADMIN));
  then
    $outcome.setSuccess(true);
end

