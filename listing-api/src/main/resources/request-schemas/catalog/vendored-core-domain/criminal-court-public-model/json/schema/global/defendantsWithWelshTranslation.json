{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/core/courts/defendantsWithWelshTranslation.json",
  "description": "The defendant id with welsh translation required or not for hearing",
  "type": "object",
  "properties": {
    "defendantId": {
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
    },
    "welshTranslation": {
      "description": "Welsh translation is required or not for this defendant",
      "type": "boolean"
    }
  },
  "required": [
    "defendantId",
    "welshTranslation"
  ],
  "additionalProperties": false
}
