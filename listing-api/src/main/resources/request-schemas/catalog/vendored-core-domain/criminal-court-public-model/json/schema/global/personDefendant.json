{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/core/courts/personDefendant.json",
  "type": "object",
  "properties": {
    "personDetails": {
      "$ref": "http://justice.gov.uk/core/courts/person.json"
    },
    "bailStatus": {
      "$ref": "http://justice.gov.uk/core/courts/bailStatus.json"
    },
    "bailConditions": {
      "description": "Defines the conditions that have been applied to the Order of Bail, or Order of Remand into the care of the Local Authority",
      "type": "string"
    },
    "policeBailStatus": {
      "description": "BailStatus from the police. Should be written only once by police sources such as SPI",
      "$ref": "http://justice.gov.uk/core/courts/bailStatus.json"
    },
    "policeBailConditions": {
      "description": "BailConditions from the police. Should be written only once by police sources such as SPI",
      "type": "string"
    },
    "bailReasons": {
      "description": "Defines the reasons for setting bail conditions or the reasons for custody",
      "type": "string"
    },
    "custodyTimeLimit": {
      "description": "The custody time limit for the given case when the bail status is remanded-in-custody",
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/datePattern"
    },
    "perceivedBirthYear": {
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/positiveInteger"
    },
    "driverNumber": {
      "type": "string"
    },
    "driverLicenceCode": {
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/driverLicenseCode"
    },
    "driverLicenseIssue": {
      "description": "identifies the license issue no.",
      "type": "string"
    },
    "vehicleOperatorLicenceNumber": {
      "description": "You need an operator's licence to operate vehicles above 3.5 tonnes gross vehicle weight (gvw) that are used to carry goods (ie anything not permanently attached to the vehicle) on public roads for trade or business purposes.",
      "type": "string"
    },
    "arrestSummonsNumber": {
      "type": "string"
    },
    "employerOrganisation": {
      "$ref": "http://justice.gov.uk/core/courts/organisation.json"
    },
    "employerPayrollReference": {
      "type": "string"
    },
    "custodialEstablishment": {
      "description": "The custodial establishment for Defendant",
      "$ref": "#/definitions/custodyEstablishment"
    }
  },
  "required": [
    "personDetails"
  ],
  "additionalProperties": false,
  "definitions": {
    "custodyEstablishment": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
        },
        "custody": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "custody"
      ]
    }
  }
}