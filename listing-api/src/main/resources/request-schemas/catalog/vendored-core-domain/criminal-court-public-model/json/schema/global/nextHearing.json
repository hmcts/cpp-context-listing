{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/core/courts/nextHearing.json",
  "type": "object",
  "properties": {
    "type": {
      "$ref": "http://justice.gov.uk/core/courts/hearingType.json"
    },
    "jurisdictionType": {
      "$ref": "http://justice.gov.uk/core/courts/jurisdictionType.json"
    },
    "reportingRestrictionReason": {
      "type": "string"
    },
    "adjournmentReason": {
      "type": "string"
    },
    "hearingLanguage": {
      "$ref": "http://justice.gov.uk/core/courts/hearingLanguage.json"
    },
    "listedStartDateTime": {
      "description": "The date and time that has been pre-arranged and therefore must be listed accordingly.  Since the Police grant bail, Police requests will arrive at court with a pre-agreed date and time as per the bail arrangements.  Similarly adjournments will result in a pre-arranged date and time",
      "type": "string",
      "format": "date-time"
    },
    "estimatedMinutes": {
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/positiveInteger"
    },
    "estimatedDuration": {
      "description": "Value from the Estimated Duration prompt",
      "type": "string"
    },
    "courtCentre": {
      "$ref": "http://justice.gov.uk/core/courts/courtCentre.json"
    },
    "judiciary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/judicialRole.json"
      }
    },
    "nextHearingProsecutionCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/nextHearingProsecutionCase.json"
      }
    },
    "nextHearingCourtApplicationId": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
      }
    },
    "existingHearingId": {
      "description": "The id of an existing hearing which these next hearing cases/application will be adjourned to.",
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
    },
    "bookingReference": {
      "description": "Scheduled booking reference for provisionally booked slots in magistrates courts.",
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
    },
    "reservedJudiciary": {
      "description": "Flag to indicate whether the same judiciaries in the current hearing should be reserved for the next hearing.",
      "type": "boolean"
    },
    "weekCommencingDate": {
      "description": "Hearing week commencing start date.",
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/datePattern"
    },
    "dateToBeFixed": {
      "description": "Flag to indicate that the next hearing needs to be listed as unscheduled hearing without any start date.",
      "type": "boolean"
    },
    "isFirstReviewHearing": {
    	"type": "boolean"
    },
    "orderName": {
    	"type": "string"
    },
    "suspendedPeriod": {
    	"type": "string"
    },
    "totalCustodialPeriod": {
    	"type": "string"
    },
    "endDate": {
    	"$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/datePattern"
    },
    "probationTeamName": {
    	"type": "string"
    },
    "probationTeamAddress": {
    	"type": "string"
    },
    "reviewFrequency": {
      "type": "string"
    },
    "applicationTypeCode": {
      "type": "string"
    },
    "hmiSlots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/rotaSlot.json"
      }
    },
    "isGroupProceedings": {
      "description": "The hearing is a logical grouping of cases when it is true",
      "type": "boolean"
    },
    "numberOfGroupCases": {
      "description": "The number of group cases",
      "type": "integer"
    },
    "courtScheduleId": {
      "type": "string"
    }
  },
  "oneOf": [
    {
      "required": [
        "type",
        "courtCentre",
        "estimatedMinutes",
        "listedStartDateTime"
      ]
    },
    {
      "required": [
        "type",
        "courtCentre",
        "estimatedMinutes",
        "weekCommencingDate"
      ]
    },
    {
      "required": [
        "type",
        "courtCentre",
        "dateToBeFixed"
      ]
    }
  ],
  "additionalProperties": false
}